rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidHospitalState(data) {
      return data.keys().hasAll(['ownerId', 'hospitalName', 'directorName', 'province', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'hospitalName', 'directorName', 'province', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data. ownerId == request.auth.uid
        && data.hospitalName is string && data.hospitalName.size() >= 1 && data.hospitalName.size() <= 200
        && data.directorName is string && data.directorName.size() >= 1 && data.directorName.size() <= 150
        && data.province is string && data.province.size() >= 1 && data.province.size() <= 150
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /hospitalStates/{stateId} {
      allow get: if isSignedIn() && isValidId(stateId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(stateId)
        && isValidHospitalState(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(stateId)
        && isValidHospitalState(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['hospitalName', 'directorName', 'province', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(stateId) && existing().ownerId == request.auth.uid;
    }
  }
}
